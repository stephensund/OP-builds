# ===============================
# Target / Device
# ===============================
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_asus_rt-ac42u=y

# ===============================
# LuCI
# ===============================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-firewall=y

# ===============================
# IPv6 (WAN DHCPv6 client + LAN RA/DHCPv6 server + LuCI support)
# ===============================
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# IPv6 firewall compatibility layer (nft backend)
CONFIG_PACKAGE_ip6tables-nft=y

# ===============================
# CPU frequency scaling
# ===============================
# 25.12/24.10 里没有 kmod-cpufreq / kmod-cpufreq-ipq40xx / kmod-qcom-cpufreq / cpufrequtils
# 这几个符号（主仓库与全部默认 feed 均无定义），功能由 emortal 的 cpufreq 包提供：
# luci-app-cpufreq(DEPENDS +cpufreq)，且 ipq40xx 的 DEFAULT_PACKAGES 已默认包含
CONFIG_PACKAGE_luci-app-cpufreq=y

# ===============================
# Passwall
# ===============================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_sing-box=y
# passwall 的 INCLUDE 开关区分大小写，写错（如 INCLUDE_singbox）会被静默忽略并回落到 default
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# 关掉 rust 系组件：它们会拉起 rust/host 编译器（数小时且在本 runner 上必失败）；SS 由 sing-box 提供
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
# 下面几个 INCLUDE 默认是 y，不显式关掉会把已禁用的包重新拉回来
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n
# 只用 sing-box：SmartDNS 与 Simple-Obfs 的 INCLUDE 默认都是 y，一并关掉
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n

# ===============================
# Firewall / netfilter deps
# ===============================
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# ===============================
# DNS helpers
# ===============================
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y

# ===============================
# Disabled heavy components
# ===============================
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_trojan-plus=n
CONFIG_PACKAGE_haproxy=n
CONFIG_PACKAGE_ipt2socks=n
CONFIG_PACKAGE_v2ray-geoip=n
CONFIG_PACKAGE_v2ray-geosite=n

# ===============================
# LuCI themes
# ===============================
CONFIG_PACKAGE_luci-theme-argon=y
# luci-app-argon-config 在 25.12 已合并进 luci-theme-argon（PKG_PROVIDES），不是独立包
CONFIG_PACKAGE_luci-theme-kucat=y
CONFIG_PACKAGE_luci-app-kucat-config=y

# ===============================
# USB
# ===============================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y

# ===============================
# Tools and certificates
# ===============================
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y

# ===============================
# BusyBox options
# ===============================
CONFIG_BUSYBOX_DEFAULT_NOLOGIN=y
CONFIG_BUSYBOX_DEFAULT_FEATURE_SH_IS_NONE=y

# ===============================
# Keep dependencies from being stripped
# ===============================
CONFIG_ALL_NONSHARED=y
